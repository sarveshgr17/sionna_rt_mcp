<file path="frontend/src/services/mcp/client.ts">
import {
  ComparisonResult,
  EnvironmentReport,
  ExperimentDetails,
  ListExperimentsResponse,
  PointToPointParams,
  PointToPointResult,
  RadioMapParams,
  RadioMapResult,
  SceneCatalog,
  TelemetryRecentResponse,
} from "@/types/mcp";

const API_BASE = import.meta.env.VITE_API_URL || "/api";

export interface ToolCallResponse<T = any> {
  status: "success" | "error";
  data?: T;
  error?: string;
}

export interface HealthResponse {
  status: string;
  mcp_connected: boolean;
  mcp_server_url: string;
  tool_count: number;
  tools: Array<{
    name: string;
    description: string;
    inputSchema: any;
  }>;
}

export class McpClientError extends Error {
  constructor(message: string, public readonly details?: any) {
    super(message);
    this.name = "McpClientError";
  }
}

/**
 * Centralized MCP Client connecting to the Sionna Lab Backend Adapter.
 */
export const mcpClient = {
  /**
   * Check health and connection to MCP server.
   */
  async getHealth(): Promise<HealthResponse> {
    const res = await fetch(`${API_BASE}/health`);
    if (!res.ok) {
      throw new McpClientError(`Health check failed with HTTP ${res.status}`);
    }
    return res.json();
  },

  /**
   * Generic low-level tool invocation through MCP bridge.
   */
  async callTool<T = any>(name: string, args: Record<string, any> = {}): Promise<T> {
    const res = await fetch(`${API_BASE}/mcp/call`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name, arguments: args }),
    });

    const json: ToolCallResponse<T> = await res.json();
    if (!res.ok || json.status === "error") {
      throw new McpClientError(json.error || `Tool '${name}' failed`, json);
    }

    return json.data as T;
  },

  // 1. check_environment
  async checkEnvironment(): Promise<EnvironmentReport> {
    return this.callTool<EnvironmentReport>("check_environment");
  },

  // 2. list_scenes
  async listScenes(): Promise<SceneCatalog> {
    return this.callTool<SceneCatalog>("list_scenes");
  },

  // 3. run_simulation (Point-to-Point Ray Tracing)
  async runSimulation(params: PointToPointParams): Promise<PointToPointResult> {
    return this.callTool<PointToPointResult>("run_simulation", params);
  },

  // 4. generate_radio_map (Spatial 2D Coverage)
  async generateRadioMap(params: RadioMapParams): Promise<RadioMapResult> {
    return this.callTool<RadioMapResult>("generate_radio_map", params);
  },

  // 5. list_experiments
  async listExperiments(): Promise<ListExperimentsResponse> {
    return this.callTool<ListExperimentsResponse>("list_experiments");
  },

  // 6. get_experiment_details
  async getExperimentDetails(experimentId: string): Promise<ExperimentDetails> {
    return this.callTool<ExperimentDetails>("get_experiment_details", {
      experiment_id: experimentId,
    });
  },

  // 7. compare_experiments
  async compareExperiments(
    experimentIdA: string,
    experimentIdB: string,
    generateHeatmaps: boolean = true
  ): Promise<ComparisonResult> {
    return this.callTool<ComparisonResult>("compare_experiments", {
      experiment_id_a: experimentIdA,
      experiment_id_b: experimentIdB,
      generate_heatmaps: generateHeatmaps,
    });
  },

  // Telemetry: Recent Runs for Workspace Dashboard
  async getTelemetryRecent(): Promise<TelemetryRecentResponse> {
    const res = await fetch(`${API_BASE}/telemetry/recent`);
    if (!res.ok) {
      throw new McpClientError(`Telemetry fetch failed with HTTP ${res.status}`);
    }
    return res.json();
  },

  // Matrix Data: Read .npz numerical arrays
  async getMatrixData(experimentId: string): Promise<any> {
    const res = await fetch(`${API_BASE}/matrix/${encodeURIComponent(experimentId)}`);
    if (!res.ok) {
      throw new McpClientError(`Matrix data fetch failed with HTTP ${res.status}`);
    }
    return res.json();
  },

  // Safe Artifact URL constructor
  getArtifactUrl(path?: string): string {
    if (!path) return "";
    if (path.startsWith("http://") || path.startsWith("https://")) {
      return path;
    }
    return `${API_BASE}/artifacts/${encodeURIComponent(path)}`;
  },
};
</file>

<file path="frontend/src/types/mcp.ts">
/**
 * TypeScript definitions strictly aligned with the 7 canonical MCP tools
 * registered on the NVIDIA Sionna RT MCP Server.
 */

// 1. check_environment
export interface EnvironmentReport {
  python_version: string;
  sionna_version: string;
  mitsuba_version: string;
  backend: string;
  is_usable: boolean;
}

// 2. list_scenes
export interface SceneItem {
  name: string;
  description: string;
  is_default: boolean;
}

export interface SceneCatalog {
  scenes: SceneItem[];
  default_scene: string;
  count: number;
}

// 3. run_simulation (Point-to-Point)
export interface PointToPointParams {
  scene: string;
  frequency_hz: number;
  tx_position: [number, number, number];
  rx_position: [number, number, number];
  tx_power_dbm: number;
  antenna_type?: string;
  polarization?: string;
  num_rows?: number;
  num_cols?: number;
  horizontal_spacing?: number;
  vertical_spacing?: number;
  tx_antenna_type?: string;
  rx_antenna_type?: string;
  tx_orientation_deg?: [number, number, number];
  rx_orientation_deg?: [number, number, number];
}

export interface PointToPointResult {
  frequency_hz: number;
  tx_position: [number, number, number];
  rx_position: [number, number, number];
  tx_power_dbm: number;
  backend: string;
  num_paths: number;
  total_path_loss: number;
  received_power: number;
  path_delays: number[];
  path_distances: number[];
  path_gains: number[];
  interaction_types: string[];
  simulation_id?: string;
  created_at?: string;
}

// 4. generate_radio_map
export interface RadioMapParams {
  scene_name: string;
  frequency_hz: number;
  tx_name?: string;
  tx_position: [number, number, number];
  tx_power_dbm: number;
  tx_orientation_deg?: [number, number, number];
  antenna_type?: string;
  polarization?: string;
  num_rows?: number;
  num_cols?: number;
  horizontal_spacing?: number;
  vertical_spacing?: number;
  region_mode?: "auto" | "manual";
  auto_margin?: number;
  auto_include_tx?: boolean;
  x_min?: number | null;
  x_max?: number | null;
  y_min?: number | null;
  y_max?: number | null;
  receiver_height?: number;
  cell_size?: number | [number, number];
  samples_per_tx?: number;
  max_depth?: number;
  seed?: number | null;
  los?: boolean;
  specular_reflection?: boolean;
  diffraction?: boolean;
  scattering?: boolean;
  experiment_name?: string | null;
}

export interface RadioMapArtifactPaths {
  rss_heatmap?: string;
  path_gain_heatmap?: string;
  radio_map_data?: string;
  metadata?: string;
}

export interface RadioMapResult {
  status: string;
  experiment_id: string;
  experiment_name?: string | null;
  scene_name: string;
  frequency_hz: number;
  tx_position: [number, number, number];
  tx_power_dbm: number;
  measurement_height: number;
  grid_dimensions: [number, number];
  cell_size: [number, number] | number;
  region_bounds: [number, number, number, number]; // [x_min, x_max, y_min, y_max]
  total_cells: number;
  valid_cells: number;
  zero_power_cells: number;
  coverage_percentage: number;
  min_rss_dbm: number;
  mean_rss_dbm: number;
  max_rss_dbm: number;
  heatmaps_available: {
    rss: boolean;
    path_gain: boolean;
  };
  artifact_paths: RadioMapArtifactPaths;
  simulation_timestamp: string;
  backend_variant: string;
}

// 5. list_experiments
export interface ExperimentSummary {
  experiment_id: string;
  experiment_name?: string | null;
  scene_name: string;
  frequency_hz: number;
  tx_position: [number, number, number];
  tx_power_dbm: number;
  measurement_height: number;
  grid_dimensions: [number, number];
  cell_size: [number, number];
  total_cells: number;
  valid_cells: number;
  coverage_percentage: number;
  mean_rss_dbm: number;
  min_rss_dbm: number;
  max_rss_dbm: number;
  simulation_timestamp: string;
  heatmaps_available: {
    rss: boolean;
    path_gain: boolean;
  };
}

export interface ListExperimentsResponse {
  status: string;
  experiments: ExperimentSummary[];
  count: number;
}

// 6. get_experiment_details
export interface ExperimentDetails extends ExperimentSummary {
  antenna_type: string;
  polarization: string;
  region_bounds: [number, number, number, number];
  solver_parameters: {
    samples_per_tx: number;
    max_depth: number;
    seed?: number | null;
    los: boolean;
    specular_reflection: boolean;
    diffraction: boolean;
    scattering: boolean;
  };
  backend_variant: string;
  array_shapes: Record<string, number[]>;
  array_names: string[];
  artifact_paths: RadioMapArtifactPaths;
}

// 7. compare_experiments
export interface MetricStats {
  mean_diff_db?: number;
  min_diff_db?: number;
  max_diff_db?: number;
  std_diff_db?: number;
  mean_difference?: number;
  min_difference?: number;
  max_difference?: number;
  std_difference?: number;
  total_cells: number;
  valid_cells: number;
  invalid_cells: number;
  valid_cells_percentage: number;
}

export interface ComparisonResult {
  status: string;
  difference_convention: string; // "B - A"
  experiment_a_id: string;
  experiment_b_id: string;
  scene_name: string;
  measurement_height: number;
  frequency_a_hz: number;
  frequency_b_hz: number;
  frequency_match: boolean;
  grid_dimensions: [number, number];
  cell_size: [number, number];
  region_bounds: [number, number, number, number];
  total_cells: number;
  valid_cells: number;
  invalid_cells: number;
  valid_cells_percentage: number;
  rss_difference_metrics: MetricStats;
  path_gain_difference_metrics: MetricStats;
  heatmaps?: {
    rss_diff?: string;
    path_gain_diff?: string;
  };
  artifacts?: {
    rss_diff?: string;
    path_gain_diff?: string;
    comparison_data?: string;
    metadata?: string;
  };
  heatmaps_available?: {
    rss_diff: boolean;
    path_gain_diff: boolean;
  };
  comparison_timestamp: string;
}

// Dashboard Recent Runs Telemetry
export interface RecentRunItem {
  id: string;
  type: "p2p" | "radio_map";
  scene: string;
  carrier: string;
  received_power?: number;
  mean_rss?: number;
  num_paths?: number;
  total_cells?: number;
  created_at: string;
  status: "SUCCESS" | "FAILED" | "RUNNING";
  metrics?: any;
  metadata?: any;
}

export interface TelemetryRecentResponse {
  status: string;
  total_runs: number;
  p2p_runs: number;
  radio_map_runs: number;
  latest_execution?: RecentRunItem | null;
  recent_runs: RecentRunItem[];
}
