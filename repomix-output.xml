<file path="frontend/src/components/layout/Header.tsx">
import React from "react";
import { Link, useLocation } from "react-router-dom";
import { 
  Box, 
  ChevronDown, 
  Code2, 
  FileText, 
  ExternalLink,
  Cpu,
  User
} from "lucide-react";
import { useEnvironment, useMcpHealth, useScenes } from "@/hooks/useMcp";

export function Header() {
  const location = useLocation();
  const { data: health } = useMcpHealth();
  const { data: env } = useEnvironment();
  const { data: scenes } = useScenes();

  // Page titles
  const getBreadcrumb = () => {
    switch (location.pathname) {
      case "/":
        return "Workstation";
      case "/p2p":
        return "Point-to-Point Simulation";
      case "/radio-maps":
        return "Radio Maps";
      case "/experiments":
        return "Experiments Archive";
      case "/compare":
        return "Compare Experiments";
      case "/system":
        return "System / Environment Diagnostics";
      default:
        return "Workstation";
    }
  };

  const isConnected = health?.mcp_connected ?? false;
  const backendName = env?.backend || "llvm_ad_mono_polarized";
  const defaultScene = scenes?.default_scene || "simple_reflector";

  return (
    <header className="h-12 border-b border-border bg-white px-4 flex items-center justify-between select-none">
      {/* Left: Breadcrumbs & Engine Indicators */}
      <div className="flex items-center gap-3">
        <div className="flex items-center gap-1.5 text-xs text-slate-500 font-medium">
          <Link to="/" className="hover:text-slate-800 transition-colors">Sionna Lab</Link>
          <span>/</span>
          <span className="text-slate-800 font-semibold">{getBreadcrumb()}</span>
        </div>

        <div className="h-4 w-[1px] bg-border mx-1" />

        {/* Scene Selector Dropdown Pill */}
        <div className="flex items-center gap-1.5 px-2.5 py-1 bg-parchment-subtle rounded border border-border text-xs font-mono text-slate-700 cursor-pointer hover:bg-parchment transition-colors">
          <Box className="w-3.5 h-3.5 text-rust" />
          <span className="font-medium">Scene: {defaultScene}</span>
          <ChevronDown className="w-3 h-3 text-slate-400 ml-0.5" />
        </div>

        {/* Engine Variant Pill */}
        <div className="flex items-center gap-1.5 px-2 py-1 bg-parchment-subtle rounded border border-border text-xs font-mono text-slate-600">
          <Code2 className="w-3 h-3 text-slate-500" />
          <span>{backendName}</span>
        </div>
      </div>

      {/* Right: Simulator Status & Actions */}
      <div className="flex items-center gap-3">
        {/* Status indicator */}
        <div className={`px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold flex items-center gap-1.5 border ${
          isConnected 
            ? "bg-green-50 text-green-700 border-green-200" 
            : "bg-red-50 text-red-700 border-red-200"
        }`}>
          <span className={`w-2 h-2 rounded-full ${isConnected ? "bg-green-500 animate-pulse" : "bg-red-500"}`} />
          {isConnected ? "SIMULATOR READY" : "SIMULATOR OFFLINE"}
        </div>

        {/* Documentation link */}
        <a 
          href="https://nvlabs.github.io/sionna/" 
          target="_blank" 
          rel="noreferrer"
          className="flex items-center gap-1.5 px-2.5 py-1 text-xs text-slate-600 hover:text-slate-900 rounded border border-border bg-white hover:bg-parchment transition-colors"
        >
          <FileText className="w-3.5 h-3.5 text-slate-500" />
          <span>Docs</span>
        </a>

        {/* MCP Inspector button */}
        <Link 
          to="/system"
          className="flex items-center gap-1.5 px-2.5 py-1 text-xs text-slate-600 hover:text-slate-900 rounded border border-border bg-white hover:bg-parchment transition-colors"
        >
          <Cpu className="w-3.5 h-3.5 text-rust" />
          <span>MCP Inspector</span>
        </Link>

        {/* User avatar */}
        <div className="w-7 h-7 rounded-full bg-rust flex items-center justify-center text-white shadow-sm ring-1 ring-rust/20">
          <User className="w-4 h-4" />
        </div>
      </div>
    </header>
  );
}
</file>

<file path="frontend/src/components/layout/Sidebar.tsx">
import React from "react";
import { NavLink } from "react-router-dom";
import {
  LayoutDashboard,
  Radio,
  Map,
  FolderGit2,
  GitCompare,
  Sliders,
  Terminal,
  FileCode2,
  Settings,
  Waves,
} from "lucide-react";
import { useEnvironment, useMcpHealth } from "@/hooks/useMcp";

const NAV_ITEMS = [
  { path: "/", label: "Overview", icon: LayoutDashboard },
  { path: "/p2p", label: "Point-to-Point Simulation", icon: Radio },
  { path: "/radio-maps", label: "Radio Maps", icon: Map },
  { path: "/experiments", label: "Experiments", icon: FolderGit2 },
  { path: "/compare", label: "Compare Experiments", icon: GitCompare },
  { path: "/system", label: "System / Environment", icon: Sliders },
];

export function Sidebar() {
  const { data: health } = useMcpHealth();
  const { data: env } = useEnvironment();

  const isConnected = health?.mcp_connected ?? false;
  const sionnaVersion = env?.sionna_version || "2.2.0";
  const mitsubaVersion = env?.mitsuba_version || "3.9.1";
  const backendShort = env?.backend?.includes("llvm") ? "CPU-LLVM" : "RTX-6000";

  return (
    <aside className="w-64 border-r border-border bg-parchment-sidebar flex flex-col justify-between select-none shrink-0 h-screen sticky top-0">
      {/* Top: Branding & Navigation */}
      <div>
        {/* Brand Header */}
        <div className="p-4 border-b border-border/80">
          <div className="flex items-center gap-2.5">
            <div className="w-8 h-8 rounded bg-rust flex items-center justify-center text-white shadow-sm">
              <Waves className="w-5 h-5" />
            </div>
            <div className="flex-1 min-w-0">
              <div className="flex items-center justify-between">
                <span className="font-bold text-sm text-slate-900 tracking-tight">Sionna Lab</span>
                <span className="text-[10px] font-mono px-1.5 py-0.5 rounded bg-parchment-subtle border border-border text-slate-600 font-semibold">
                  v0.9.4-rc2
                </span>
              </div>
              <p className="text-[11px] text-slate-500 truncate mt-0.5 font-medium">
                Explore the physics of wireless propagation
              </p>
            </div>
          </div>
        </div>

        {/* Navigation Section */}
        <div className="px-3 py-4">
          <div className="px-3 pb-2 text-[10px] font-mono font-bold tracking-wider text-slate-600 uppercase">
            Simulation Suites
          </div>
          <nav className="space-y-1">
            {NAV_ITEMS.map((item) => {
              const Icon = item.icon;
              return (
                <NavLink
                  key={item.path}
                  to={item.path}
                  className={({ isActive }) =>
                    `flex items-center gap-2.5 px-3 py-2 rounded text-xs font-medium transition-all group relative ${
                      isActive
                        ? "bg-white text-rust font-semibold shadow-technical border border-border/90"
                        : "text-slate-600 hover:text-slate-900 hover:bg-parchment-subtle/80"
                    }`
                  }
                >
                  {({ isActive }) => (
                    <>
                      {isActive && (
                        <span className="absolute left-0 top-1.5 bottom-1.5 w-1 bg-rust rounded-r" />
                      )}
                      <Icon className={`w-4 h-4 shrink-0 ${isActive ? "text-rust" : "text-slate-500 group-hover:text-slate-700"}`} />
                      <span className="truncate">{item.label}</span>
                    </>
                  )}
                </NavLink>
              );
            })}
          </nav>
        </div>
      </div>

      {/* Bottom: MCP Daemon Status & Hardware Specs */}
      <div className="p-3 border-t border-border bg-parchment-subtle/40">
        <div className="p-3 rounded-md bg-white border border-border/80 shadow-technical text-[11px] space-y-2">
          {/* Server Connection Indicator */}
          <div className="flex items-center justify-between pb-1.5 border-b border-border/60">
            <div className="flex items-center gap-1.5">
              <span className={`w-2 h-2 rounded-full ${isConnected ? "bg-green-500" : "bg-red-500"}`} />
              <span className="font-semibold text-slate-800">MCP Server</span>
            </div>
            <span className={`font-mono text-[10px] ${isConnected ? "text-green-600 font-bold" : "text-red-500"}`}>
              {isConnected ? "Connected" : "Disconnected"}
