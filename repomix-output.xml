    mem_before = get_memory_info()

    # Step 1: Config & Engine Init
    t0_setup = time.perf_counter()
    config = RadioMapConfig(
        scene_name="simple_reflector",
        frequency_hz=3.5e9,
        tx_position=(0.0, -10.0, 5.0),
        tx_power_dbm=30.0,
        tx_orientation_deg=(0.0, 0.0, 0.0),
