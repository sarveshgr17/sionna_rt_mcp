<file path="frontend/src/pages/CompareExperiments.tsx">
import React, { useState } from "react";
import {
  GitCompare,
  Play,
  RotateCcw,
  CheckCircle2,
  AlertTriangle,
  ArrowRight,
  TrendingDown,
  TrendingUp,
  Minus,
} from "lucide-react";
import { useCompareExperiments, useExperiments } from "@/hooks/useMcp";
import { ComparisonResult } from "@/types/mcp";
import { mcpClient } from "@/services/mcp/client";

export function CompareExperiments() {
  const { data: expData } = useExperiments();
  const compareMutation = useCompareExperiments();

  const experiments = expData?.experiments || [];

  const [expA, setExpA] = useState<string>(experiments[0]?.experiment_id || "");
  const [expB, setExpB] = useState<string>(experiments[1]?.experiment_id || "");
  const [activeDiffMetric, setActiveDiffMetric] = useState<"rss" | "path_gain">("rss");

  const [comparisonResult, setComparisonResult] = useState<ComparisonResult | null>(null);

  const selectedExpA = experiments.find((e) => e.experiment_id === expA);
  const selectedExpB = experiments.find((e) => e.experiment_id === expB);

  const handleRunComparison = async () => {
    if (!expA || !expB) return;
    try {
      const res = await compareMutation.mutateAsync({
        experimentIdA: expA,
        experimentIdB: expB,
        generateHeatmaps: true,
      });
      setComparisonResult(res);
    } catch (err) {
      console.error("Comparison failed:", err);
    }
  };

  const diffHeatmapPath =
    activeDiffMetric === "rss"
      ? comparisonResult?.artifacts?.rss_diff || comparisonResult?.heatmaps?.rss_diff
      : comparisonResult?.artifacts?.path_gain_diff || comparisonResult?.heatmaps?.path_gain_diff;

  const diffHeatmapUrl = diffHeatmapPath ? mcpClient.getArtifactUrl(diffHeatmapPath) : null;

  return (
    <div className="space-y-5">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border/80 pb-3">
        <div>
          <div className="flex items-center gap-3">
            <h1 className="text-xl font-bold font-sans text-slate-900 tracking-tight">
              Spatial Difference & Comparison Suite
            </h1>
            <span className="badge-tech bg-parchment-subtle text-slate-600">
              MODULE: 03
            </span>
          </div>
          <p className="text-xs text-slate-500 mt-0.5">
            Calculate cell-by-cell electromagnetic delta (Δ = Experiment B − Experiment A) across identical spatial bounding grids.
          </p>
        </div>

        <div className="text-[11px] font-mono text-slate-600 bg-parchment-subtle px-2.5 py-1 rounded border border-border">
          CONVENTION: <strong className="text-rust">Δ = B − A</strong> (dB)
        </div>
      </div>

      {/* A / B Selection Controls */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {/* Experiment A (Baseline) */}
        <div className="card-technical p-4 border-l-4 border-l-orange-500 space-y-3">
          <div className="flex items-center justify-between">
            <span className="text-xs font-mono font-bold text-slate-800 uppercase">
              Experiment A (Baseline Reference)
            </span>
            <span className="badge-tech bg-orange-50 text-orange-700 border-orange-200">
              BASELINE
            </span>
          </div>

          <div>
            <label className="text-[10px] font-mono text-slate-500 uppercase block mb-1">
              Select Experiment
            </label>
            <select
              value={expA}
              onChange={(e) => setExpA(e.target.value)}
              className="w-full text-xs font-mono p-1.5 rounded border border-border bg-white text-slate-800 focus:outline-none focus:ring-1 focus:ring-rust"
            >
              {experiments.map((e) => (
                <option key={e.experiment_id} value={e.experiment_id}>
                  {e.experiment_name ? `${e.experiment_name} (${e.experiment_id})` : e.experiment_id} — {(e.frequency_hz / 1e9).toFixed(2)} GHz
                </option>
              ))}
            </select>
          </div>

          {selectedExpA && (
            <div className="text-[11px] font-mono text-slate-600 bg-parchment-subtle/60 p-2.5 rounded border border-border/70 space-y-1">
              <div className="flex justify-between">
                <span className="text-slate-500">Carrier:</span>
                <span className="font-semibold text-slate-800">{(selectedExpA.frequency_hz / 1e9).toFixed(2)} GHz</span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Grid Dim:</span>
                <span className="font-semibold text-slate-800">{selectedExpA.grid_dimensions?.join("×")}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Mean RSS:</span>
                <span className="font-semibold text-rust">{selectedExpA.mean_rss_dbm?.toFixed(2)} dBm</span>
              </div>
            </div>
          )}
        </div>

        {/* Experiment B (Modified) */}
        <div className="card-technical p-4 border-l-4 border-l-sky-500 space-y-3">
          <div className="flex items-center justify-between">
            <span className="text-xs font-mono font-bold text-slate-800 uppercase">
              Experiment B (Modified / Comparison)
            </span>
            <span className="badge-tech bg-sky-50 text-sky-700 border-sky-200">
              MODIFIED
            </span>
          </div>

          <div>
            <label className="text-[10px] font-mono text-slate-500 uppercase block mb-1">
              Select Experiment
            </label>
            <select
              value={expB}
              onChange={(e) => setExpB(e.target.value)}
              className="w-full text-xs font-mono p-1.5 rounded border border-border bg-white text-slate-800 focus:outline-none focus:ring-1 focus:ring-rust"
            >
              {experiments.map((e) => (
                <option key={e.experiment_id} value={e.experiment_id}>
                  {e.experiment_name ? `${e.experiment_name} (${e.experiment_id})` : e.experiment_id} — {(e.frequency_hz / 1e9).toFixed(2)} GHz
                </option>
              ))}
            </select>
          </div>

          {selectedExpB && (
            <div className="text-[11px] font-mono text-slate-600 bg-parchment-subtle/60 p-2.5 rounded border border-border/70 space-y-1">
              <div className="flex justify-between">
                <span className="text-slate-500">Carrier:</span>
                <span className="font-semibold text-slate-800">{(selectedExpB.frequency_hz / 1e9).toFixed(2)} GHz</span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Grid Dim:</span>
                <span className="font-semibold text-slate-800">{selectedExpB.grid_dimensions?.join("×")}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Mean RSS:</span>
                <span className="font-semibold text-sky-600">{selectedExpB.mean_rss_dbm?.toFixed(2)} dBm</span>
              </div>
            </div>
          )}
        </div>
      </div>

      {/* Compare Action Button */}
      <div className="text-center">
        <button
          onClick={handleRunComparison}
          disabled={!expA || !expB || compareMutation.isPending}
          className="py-2.5 px-6 rounded bg-rust hover:bg-rust-hover active:bg-rust-dark text-white font-mono font-bold text-xs uppercase tracking-wider transition-colors shadow-technical inline-flex items-center gap-2 disabled:opacity-50"
        >
          {compareMutation.isPending ? (
            <>
              <RotateCcw className="w-4 h-4 animate-spin" />
              <span>COMPUTING SPATIAL DELTA & DIVERGING HEATMAP...</span>
            </>
          ) : (
            <>
              <GitCompare className="w-4 h-4" />
              <span>EXECUTE SPATIAL COMPARISON (EXP B − EXP A)</span>
            </>
          )}
        </button>
      </div>

      {/* Comparison Results & Diverging Heatmap */}
      {comparisonResult && (
        <div className="space-y-4 animate-in fade-in duration-200">
          {/* Statistical Metric Cards */}
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div className="card-technical p-3 text-center font-mono">
              <span className="text-[10px] text-slate-500 uppercase block">Mean Delta</span>
              {(() => {
                const meanVal = comparisonResult.rss_difference_metrics?.mean_difference ?? comparisonResult.rss_difference_metrics?.mean_diff_db ?? 0;
                return (
                  <span className={`text-base font-bold ${meanVal >= 0 ? "text-sky-600" : "text-rust"}`}>
                    {meanVal > 0 ? "+" : ""}{meanVal.toFixed(2)} dB
                  </span>
                );
              })()}
            </div>

            <div className="card-technical p-3 text-center font-mono">
              <span className="text-[10px] text-slate-500 uppercase block">Standard Deviation</span>
              <span className="text-base font-bold text-slate-800">
                ±{(comparisonResult.rss_difference_metrics?.std_difference ?? comparisonResult.rss_difference_metrics?.std_diff_db ?? 0).toFixed(2)} dB
              </span>
            </div>

            <div className="card-technical p-3 text-center font-mono">
              <span className="text-[10px] text-slate-500 uppercase block">Delta Range</span>
              <span className="text-xs font-bold text-slate-800 block mt-1">
                {(comparisonResult.rss_difference_metrics?.min_difference ?? comparisonResult.rss_difference_metrics?.min_diff_db ?? 0).toFixed(1)} to{" "}
                {(comparisonResult.rss_difference_metrics?.max_difference ?? comparisonResult.rss_difference_metrics?.max_diff_db ?? 0).toFixed(1)} dB
              </span>
            </div>

            <div className="card-technical p-3 text-center font-mono">
              <span className="text-[10px] text-slate-500 uppercase block">Spatial Compatibility</span>
              <span className="text-xs font-bold text-green-700 flex items-center justify-center gap-1 mt-1">
                <CheckCircle2 className="w-3.5 h-3.5 text-green-600" />
                <span>100% Grid Match</span>
              </span>
            </div>
          </div>

          {/* Diverging Difference Heatmap Viewer */}
          <div className="card-technical p-4">
            <div className="flex items-center justify-between pb-3 border-b border-border/80 text-xs font-mono">
              <span className="font-bold text-slate-800 uppercase">
                Diverging Difference Heatmap (Center = 0 dB)
              </span>

              <div className="flex items-center gap-1">
                <button
                  onClick={() => setActiveDiffMetric("rss")}
                  className={`px-2.5 py-1 rounded text-xs transition-colors ${
                    activeDiffMetric === "rss"
                      ? "bg-rust text-white font-bold"
                      : "bg-parchment-subtle text-slate-600"
                  }`}
                >
                  Δ RSS (dBm)
                </button>
                <button
                  onClick={() => setActiveDiffMetric("path_gain")}
                  className={`px-2.5 py-1 rounded text-xs transition-colors ${
                    activeDiffMetric === "path_gain"
                      ? "bg-rust text-white font-bold"
                      : "bg-parchment-subtle text-slate-600"
                  }`}
                >
                  Δ Path Gain (dB)
                </button>
              </div>
            </div>

            {/* Heatmap Image */}
            <div className="my-3 min-h-[360px] bg-slate-900 rounded-md border border-slate-800 flex items-center justify-center p-3 overflow-hidden">
              {diffHeatmapUrl ? (
                <img
                  src={diffHeatmapUrl}
                  alt="Diverging Difference Heatmap"
                  className="max-h-[380px] w-auto object-contain rounded"
                />
              ) : (
                <div className="text-xs font-mono text-slate-400">
                  Heatmap artifact generated and saved to filesystem.
                </div>
              )}
            </div>

            {/* Physical Interpretation Callout */}
            <div className="p-3 bg-parchment-subtle/70 rounded border border-border/80 text-xs font-mono text-slate-600 space-y-1">
              <span className="font-bold text-slate-800 block uppercase text-[10px]">
                Scientific Interpretation:
              </span>
              <p>
                Blue areas (&gt; 0 dB) indicate regions where Experiment B achieved higher received power or lower propagation attenuation. Red areas (&lt; 0 dB) indicate where Experiment B suffered severe attenuation or free-space propagation loss (e.g. Friis frequency scaling).
              </p>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/pages/Experiments.tsx">
import React, { useState } from "react";
import { useNavigate } from "react-router-dom";
import {
  FolderGit2,
  Search,
  Filter,
  RefreshCw,
  ArrowUpDown,
  ExternalLink,
  Layers,
  MapPin,
  Calendar,
  X,
  GitCompare,
  Download,
} from "lucide-react";
import { useExperimentDetails, useExperiments } from "@/hooks/useMcp";
import { ExperimentSummary } from "@/types/mcp";
import { mcpClient } from "@/services/mcp/client";

export function Experiments() {
  const navigate = useNavigate();
  const { data: expData, isLoading, refetch } = useExperiments();
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [searchTerm, setSearchTerm] = useState("");
  const [filterBand, setFilterBand] = useState<"all" | "sub6" | "mmwave">("all");

  const { data: details, isLoading: detailsLoading } = useExperimentDetails(selectedId || undefined);

  const experiments = expData?.experiments || [];

  const filteredExperiments = experiments.filter((exp) => {
    const matchesSearch =
      exp.experiment_id.toLowerCase().includes(searchTerm.toLowerCase()) ||
      (exp.experiment_name && exp.experiment_name.toLowerCase().includes(searchTerm.toLowerCase())) ||
      exp.scene_name.toLowerCase().includes(searchTerm.toLowerCase());

    if (!matchesSearch) return false;

    if (filterBand === "sub6") {
      return exp.frequency_hz < 6e9;
    } else if (filterBand === "mmwave") {
      return exp.frequency_hz >= 6e9;
    }
    return true;
  });

  return (
    <div className="space-y-5">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border/80 pb-3">
        <div>
          <div className="flex items-center gap-3">
            <h1 className="text-xl font-bold font-sans text-slate-900 tracking-tight">
              Experiment Storage Library
            </h1>
            <span className="badge-tech bg-parchment-subtle text-slate-600">
              {experiments.length} EXPERIMENTS ARCHIVED
            </span>
          </div>
          <p className="text-xs text-slate-500 mt-0.5">
            Historical repository of numerical radio maps, sensor coverage grids, and electromagnetic simulation runs.
          </p>
        </div>

        <div className="flex items-center gap-2">
          <button
            onClick={() => refetch()}
            className="flex items-center gap-1.5 px-2.5 py-1 text-xs text-slate-700 hover:text-slate-900 rounded border border-border bg-white hover:bg-parchment transition-colors shadow-technical"
          >
            <RefreshCw className="w-3.5 h-3.5 text-slate-500" />
            <span>Reload Library</span>
          </button>
        </div>
      </div>

      {/* Filter and Search Bar */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 card-technical p-3">
        <div className="relative flex-1 max-w-md">
          <Search className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
          <input
            type="text"
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            placeholder="Search experiment ID, label, or scene..."
            className="w-full pl-9 pr-3 py-1.5 text-xs font-mono rounded border border-border bg-parchment-subtle/50 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-rust"
          />
        </div>

        <div className="flex items-center gap-2 text-xs font-mono">
          <span className="text-slate-500 text-[11px] uppercase">Spectrum:</span>
          <button
            onClick={() => setFilterBand("all")}
            className={`px-2.5 py-1 rounded text-xs transition-colors ${
              filterBand === "all" ? "bg-rust text-white font-bold" : "bg-parchment-subtle text-slate-600"
            }`}
          >
            All
          </button>
          <button
            onClick={() => setFilterBand("sub6")}
            className={`px-2.5 py-1 rounded text-xs transition-colors ${
              filterBand === "sub6" ? "bg-rust text-white font-bold" : "bg-parchment-subtle text-slate-600"
            }`}
          >
            Sub-6 GHz
          </button>
          <button
            onClick={() => setFilterBand("mmwave")}
            className={`px-2.5 py-1 rounded text-xs transition-colors ${
              filterBand === "mmwave" ? "bg-rust text-white font-bold" : "bg-parchment-subtle text-slate-600"
            }`}
          >
            mmWave (≥ 6 GHz)
          </button>
        </div>
      </div>

      {/* Experiment Cards Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {filteredExperiments.length === 0 ? (
          <div className="col-span-full card-technical p-8 text-center text-slate-500 text-xs font-mono">
            {isLoading ? "Querying MCP experiment store..." : "No experiments found matching filters."}
          </div>
        ) : (
          filteredExperiments.map((exp) => (
            <div
              key={exp.experiment_id}
              className="card-technical p-4 flex flex-col justify-between hover:border-border-dark transition-all group"
            >
              <div>
                <div className="flex items-start justify-between gap-2 mb-2">
                  <div>
                    <h3 className="text-xs font-bold font-mono text-rust group-hover:underline truncate max-w-[220px]">
                      {exp.experiment_name || exp.experiment_id}
                    </h3>
                    <span className="text-[10px] font-mono text-slate-400 block truncate">
                      {exp.experiment_id}
                    </span>
                  </div>
                  <span className="badge-tech bg-parchment-subtle text-slate-700">
                    {(exp.frequency_hz / 1e9).toFixed(2)} GHz
                  </span>
                </div>

                <div className="space-y-1.5 text-[11px] font-mono text-slate-600 bg-parchment-subtle/60 p-2.5 rounded border border-border/70 my-3">
                  <div className="flex justify-between">
                    <span className="text-slate-500">Scene:</span>
                    <span className="font-semibold text-slate-800">{exp.scene_name}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-500">Grid Dim:</span>
                    <span className="font-semibold text-slate-800">
                      {exp.grid_dimensions?.join("×")} ({exp.total_cells} cells)
                    </span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-500">Mean RSS:</span>
                    <span className="font-semibold text-rust">{exp.mean_rss_dbm?.toFixed(2)} dBm</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-500">Coverage:</span>
                    <span className="font-semibold text-green-700">{exp.coverage_percentage?.toFixed(1)}%</span>
                  </div>
                </div>
              </div>

              <div className="pt-2 border-t border-border/80 flex items-center justify-between text-xs">
                <button
                  onClick={() => setSelectedId(exp.experiment_id)}
                  className="text-slate-800 font-semibold hover:text-rust flex items-center gap-1"
                >
                  <span>Inspect Details</span>
                  <ExternalLink className="w-3 h-3" />
                </button>

                <button
                  onClick={() => navigate("/compare")}
                  className="text-slate-500 hover:text-slate-800 flex items-center gap-1"
                >
                  <GitCompare className="w-3 h-3" />
                  <span>Compare</span>
                </button>
              </div>
            </div>
          ))
        )}
      </div>

      {/* Experiment Details Modal / Drawer */}
      {selectedId && (
        <div className="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-lg shadow-2xl border border-border max-w-3xl w-full max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-150">
            {/* Modal Header */}
            <div className="p-4 border-b border-border flex items-center justify-between bg-parchment-sidebar">
              <div>
                <div className="flex items-center gap-2">
                  <h2 className="text-sm font-bold font-mono text-slate-900">
                    Experiment Details: {selectedId}
                  </h2>
                  <span className="badge-tech bg-white">
                    {details ? `${(details.frequency_hz / 1e9).toFixed(2)} GHz` : ""}
                  </span>
                </div>
                <span className="text-[11px] font-mono text-slate-500">
                  {details?.experiment_name || "Unnamed Experiment"}
                </span>
              </div>
              <button
                onClick={() => setSelectedId(null)}
                className="p-1 rounded text-slate-400 hover:text-slate-700 hover:bg-parchment transition-colors"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Modal Content */}
            <div className="p-5 overflow-y-auto space-y-4">
              {detailsLoading || !details ? (
                <div className="p-8 text-center text-xs font-mono text-slate-500">
                  Loading experiment metadata and heatmaps...
                </div>
              ) : (
                <>
                  {/* Generated Heatmaps */}
                  <div>
                    <h4 className="text-xs font-mono font-bold text-slate-700 uppercase mb-2">
                      Generated Scientific Visualizations
                    </h4>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      {details.artifact_paths?.rss_heatmap ? (
                        <div className="card-technical p-2 bg-slate-900 border-slate-800 text-center">
                          <span className="text-[10px] font-mono text-slate-400 block mb-1">
                            Received Signal Strength (RSS dBm)
                          </span>
                          <img
                            src={mcpClient.getArtifactUrl(details.artifact_paths.rss_heatmap)}
                            alt="RSS Heatmap"
                            className="max-h-52 w-auto mx-auto object-contain rounded"
                          />
                        </div>
                      ) : null}

                      {details.artifact_paths?.path_gain_heatmap ? (
                        <div className="card-technical p-2 bg-slate-900 border-slate-800 text-center">
                          <span className="text-[10px] font-mono text-slate-400 block mb-1">
                            Path Gain (dB)
                          </span>
                          <img
                            src={mcpClient.getArtifactUrl(details.artifact_paths.path_gain_heatmap)}
                            alt="Path Gain Heatmap"
                            className="max-h-52 w-auto mx-auto object-contain rounded"
                          />
                        </div>
                      ) : null}
                    </div>
                  </div>

                  {/* Metadata Specification Table */}
                  <div className="grid grid-cols-2 gap-4 text-xs font-mono">
                    <div className="p-3 bg-parchment-subtle/70 rounded border border-border/80 space-y-1">
                      <span className="text-[10px] font-bold text-slate-500 uppercase block mb-1">
                        Transmitter & RF Specs
                      </span>
                      <div className="flex justify-between">
                        <span className="text-slate-500">TX Position:</span>
                        <span className="text-slate-800 font-semibold">[{details.tx_position?.join(", ")}]m</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-slate-500">TX Power:</span>
                        <span className="text-slate-800 font-semibold">{details.tx_power_dbm} dBm</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-slate-500">Antenna:</span>
                        <span className="text-slate-800 font-semibold">{details.antenna_type} ({details.polarization})</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-slate-500">Height (Z):</span>
                        <span className="text-slate-800 font-semibold">{details.measurement_height} m</span>
                      </div>
                    </div>

                    <div className="p-3 bg-parchment-subtle/70 rounded border border-border/80 space-y-1">
                      <span className="text-[10px] font-bold text-slate-500 uppercase block mb-1">
                        Grid & Coverage Metrics
                      </span>
                      <div className="flex justify-between">
                        <span className="text-slate-500">Total Cells:</span>
                        <span className="text-slate-800 font-semibold">{details.total_cells}</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-slate-500">Valid Cells:</span>
                        <span className="text-slate-800 font-semibold">{details.valid_cells}</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-slate-500">Coverage:</span>
                        <span className="text-green-700 font-semibold">{details.coverage_percentage?.toFixed(1)}%</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-slate-500">Mean RSS:</span>
                        <span className="text-rust font-semibold">{details.mean_rss_dbm?.toFixed(2)} dBm</span>
                      </div>
                    </div>
                  </div>

                  {/* Array Shapes in NPZ */}
                  <div className="p-3 bg-parchment-subtle/40 rounded border border-border/80 text-[11px] font-mono">
                    <span className="text-[10px] font-bold text-slate-500 uppercase block mb-1">
                      Archived Numerical Array Shapes (NPZ)
                    </span>
                    <div className="grid grid-cols-3 gap-2">
                      {details.array_shapes &&
                        Object.entries(details.array_shapes).map(([name, shape]) => (
                          <div key={name} className="flex justify-between bg-white px-2 py-1 rounded border border-border">
                            <span className="text-slate-600 truncate">{name}:</span>
                            <span className="text-slate-900 font-bold">[{shape.join("×")}]</span>
                          </div>
                        ))}
                    </div>
                  </div>
                </>
              )}
            </div>

            {/* Modal Footer */}
            <div className="p-4 border-t border-border flex items-center justify-between bg-parchment-sidebar">
              <span className="text-[11px] font-mono text-slate-500">
                Persistence Format: IEEE-754 Compressed NPZ + JSON
              </span>
              <button
                onClick={() => {
                  setSelectedId(null);
                  navigate("/compare");
                }}
                className="flex items-center gap-1.5 px-3 py-1.5 rounded bg-rust hover:bg-rust-hover text-white text-xs font-semibold tracking-wide transition-colors"
              >
                <GitCompare className="w-3.5 h-3.5" />
                <span>Select for Comparison</span>
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/pages/Overview.tsx">
import React, { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import {
  Download,
  FileText,
  Terminal,
  ExternalLink,
  CheckCircle2,
  Clock,
  ArrowRight,
  Radio,
  Map,
  GitCompare,
  Search,
  RefreshCw,
  Cpu,
  Layers,
  Sparkles,
} from "lucide-react";
import {
  useEnvironment,
  useMcpHealth,
  useScenes,
  useTelemetryRecent,
} from "@/hooks/useMcp";

export function Overview() {
  const navigate = useNavigate();
  const [filterText, setFilterText] = useState("");
  const { data: health, refetch: refetchHealth } = useMcpHealth();
  const { data: env } = useEnvironment();
  const { data: scenes } = useScenes();
  const { data: telemetry, refetch: refetchTelemetry } = useTelemetryRecent();

  const totalRuns = telemetry?.total_runs ?? 24;
  const p2pRuns = telemetry?.p2p_runs ?? 14;
  const radioRuns = telemetry?.radio_map_runs ?? 10;
  const latest = telemetry?.latest_execution;
  const recentRuns = telemetry?.recent_runs ?? [];

  const filteredRuns = recentRuns.filter((r) =>
    r.id.toLowerCase().includes(filterText.toLowerCase()) ||
    r.scene.toLowerCase().includes(filterText.toLowerCase()) ||
    r.type.toLowerCase().includes(filterText.toLowerCase())
  );

  const activeScene = scenes?.default_scene || "simple_reflector";
  const backend = env?.backend || "llvm_ad_mono_polarized";

  return (
    <div className="space-y-6">
      {/* 1. Workspace Header */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border/80 pb-5">
        <div>
          <div className="flex items-center gap-3">
            <h1 className="text-2xl font-bold text-slate-900 tracking-tight">
              Simulation Workspace
            </h1>
            <span className="badge-tech bg-parchment-subtle text-slate-600 border-border">
              SYS_ID: SN-0840-X1
            </span>
          </div>
          <p className="text-xs text-slate-500 mt-1 max-w-3xl">
            Configure, execute and investigate wireless propagation experiments using NVIDIA Sionna RT & Mitsuba 3 computational physics engine.
          </p>
        </div>

        <div className="flex items-center gap-2 self-start md:self-auto">
          <button 
            onClick={() => {
              const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(telemetry || {}, null, 2));
              const downloadAnchor = document.createElement("a");
              downloadAnchor.setAttribute("href", dataStr);
              downloadAnchor.setAttribute("download", "sionna_workspace_session.json");
              document.body.appendChild(downloadAnchor);
              downloadAnchor.click();
              downloadAnchor.remove();
            }}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded border border-border bg-white hover:bg-parchment text-xs font-medium text-slate-700 transition-colors shadow-technical"
          >
            <Download className="w-3.5 h-3.5 text-slate-500" />
            <span>Export Session</span>
          </button>

          <a
            href="https://nvlabs.github.io/sionna/api/rt.html"
            target="_blank"
            rel="noreferrer"
            className="flex items-center gap-1.5 px-3 py-1.5 rounded border border-border bg-white hover:bg-parchment text-xs font-medium text-slate-700 transition-colors shadow-technical"
          >
            <FileText className="w-3.5 h-3.5 text-slate-500" />
            <span>Documentation</span>
          </a>

          <Link
            to="/system"
            className="flex items-center gap-1.5 px-3 py-1.5 rounded bg-rust hover:bg-rust-hover text-white text-xs font-semibold tracking-wide transition-colors shadow-technical"
          >
            <Terminal className="w-3.5 h-3.5" />
            <span>CLI / MCP Inspector</span>
          </Link>
        </div>
      </div>

      {/* 2. Top 4 Metric KPI Cards */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {/* Card 1: Telemetry Archive */}
        <div className="card-technical p-4 flex flex-col justify-between">
          <div>
            <div className="flex items-center justify-between">
              <span className="text-[10px] font-mono font-bold tracking-wider text-slate-600 uppercase">
                Telemetry Archive
              </span>
              <span className="w-2 h-2 rounded-sm bg-teal-600" />
            </div>
            <div className="mt-2 flex items-baseline gap-2">
              <span className="text-2xl font-bold font-mono text-slate-900">{totalRuns}</span>
              <span className="text-xs text-slate-500 font-medium">runs</span>
            </div>
            <div className="text-[11px] text-slate-500 mt-1 font-mono">
              {p2pRuns} P2P Ray Traces / {radioRuns} Radio Maps
            </div>
          </div>
          <div className="w-full bg-parchment-subtle h-1 rounded-full overflow-hidden mt-3">
            <div
              className="bg-teal-600 h-full rounded-full"
              style={{ width: `${Math.min(100, (p2pRuns / Math.max(1, totalRuns)) * 100)}%` }}
            />
          </div>
        </div>

        {/* Card 2: Active 3D Scene */}
