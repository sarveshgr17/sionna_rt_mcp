        )

        bounds, center, size = self.engine._compute_region(mock_scene, auto_config)

        # Expected X: [-10, 10] -> with margin 10: [-20, 20]
        # Expected Y: [-20 (tx), 15 (scene)] -> with margin 10: [-30, 25]
