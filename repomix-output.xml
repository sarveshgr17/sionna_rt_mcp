                        "scene": "simple_reflector",
                        "frequency_hz": 3.5e9,
                        "tx_position": [0.0, -10.0, 5.0],
                        "rx_position": [0.0, 10.0, 5.0],
                        "tx_power_dbm": 30.0,
                    },
                )
                dt = time.time() - t0
                sim_data = json.loads(sim_res.content[0].text)
                print(f"[✓] run_simulation executed in {dt:.3f} s:")
                print(f"    Paths found:    {sim_data.get('num_paths')}")
